# Razorpay TEST MODE credentials only for local Buildathon development.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Choose this secret yourself when creating the Razorpay webhook in Dashboard.
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_webhook_secret

# Persistence / app safety
RUPEEOS_DATABASE_URL=sqlite:///./rupeeos.db
RUPEEOS_CORS_ORIGINS=http://localhost:3000
RUPEEOS_DEMO_MODE=true
